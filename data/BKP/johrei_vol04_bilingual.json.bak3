    "category_pt": "I. Fitoterapia Oriental (*Kanpō*)"
  },
  {
    "id": "johreivol04_13",
    "volume": "Johrei Hô Kohza",
    "volume_num": 4,
    "section_num": null,
    "section_title": "",
    "article_num": 4,
    "article_title": "Sobre a Erva *Habusō*",
    "sub_letter": null,
    "position": 13,
    "parent_id": null,
    "source_ref": "Gosui-ji Roku n.º 3, pág. 22",
    "title_pt": "Sobre a Erva *Habusō*",
    "content_pt": "**(Pergunta)** Dependendo da região, bebe-se a erva *Habusō* no lugar do chá...\n\n**(Meishu-sama)** A erva *Habusō* não é nada de mais.",
    "title_jp": "波布草に就いて（御垂示録三号 二二頁）",
    "content_jp": "（御　伺）地方によりまして、「波布草」をお茶代りに飲んでおりますが──。\n\n（御垂示）「波布草」の方は大した事はない。",
