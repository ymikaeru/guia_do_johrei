    ],
    "related_items": [],
    "info_pt": "",
    "source": "",
    "Master_Title": "V. Dentes",
    "category_pt": "V. Dentes"
  },
  {
    "id": "johreivol10_77",
    "volume": "Johrei Hô Kohza",
    "volume_num": 10,
    "section_num": null,
